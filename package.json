{
  "name": "cvat-3d-suite",
  "version": "1.0.0",
  "description": "CVAT 3D Point Cloud Annotation & Alignment Assistant",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:userscript": "vite build",
    "reload": "node scripts/reload_chrome.mjs",
    "reload:cvat": "node scripts/reload_chrome.mjs --cvat",
    "test": "node --experimental-strip-types tests/geometry.test.ts && node --experimental-strip-types tests/projection.test.ts && node --experimental-strip-types tests/colorization.test.ts",
    "test:realtime": "node scripts/test_realtime_flip.mjs",
    "test:ground": "node scripts/test_ground_snap.mjs",
    "test:autofit": "node scripts/test_autofit_and_select.mjs",
    "test:modular": "node scripts/test_modular_ui_and_dimensions.mjs"
  },
  "keywords": [
    "cvat",
    "3d",
    "pointcloud",
    "lidar",
    "annotation",
    "tampermonkey"
  ],
  "author": "CVAT 3D Suite Team",
  "license": "MIT",
  "devDependencies": {
    "puppeteer": "^25.15.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  }
}
