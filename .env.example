# ==============================================================================
# CVAT Credentials & URL Configuration Template
# Sao chép file này thành .env và điền thông tin tài khoản thật của bạn:
# cp .env.example .env
# ==============================================================================

# Thông tin đăng nhập CVAT (Bắt buộc cho các script kiểm thử & CLI tool)
CVAT_USERNAME=your_cvat_username_here
CVAT_PASSWORD=your_cvat_password_here

# URL Server & Job CVAT mục tiêu
CVAT_BASE_URL=https://cvat.example.com
CVAT_JOB_URL=https://cvat.example.com/tasks/1/jobs/1

# Cấu hình phụ (tùy chọn)
CVAT_ALT_USERNAME=optional_alt_username
CVAT_ALT_BASE_URL=https://cvat-alt.example.com
CVAT_ALT_JOB_URL=https://cvat-alt.example.com/tasks/1/jobs/1
